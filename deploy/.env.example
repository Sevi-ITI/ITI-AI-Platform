# deploy\.env.example: copy it to deploy\.env (never committed) and set real values.
# docker compose reads this file for docker-compose.yaml (the whole stack), docker-compose.dev.yaml and
# docker-compose.records.yaml. One deploy\.env per machine: it says what differs between the laptop, a server and the cloud.

# --- Database (all compose files) ---
# Postgres password of the user iti. Any characters except $ (compose would read $ as a variable).
# The API in Docker gets it as PGPASSWORD; backend\.env's ITI_DATABASE_URL (native runs, tests) must use the same one.
ITI_PG_PASSWORD=change-me-to-a-long-random-password

# SQL Server SA (admin) password for docker-compose.records.yaml (dev only, not in the main stack). Letters and digits,
# 20+ characters, upper + lower case + digits (SQL Server's rules). Used only to create the DB and run the scripts.
ITI_RECORDS_SA_PASSWORD=change-me-to-a-long-random-password

# --- The whole stack (docker-compose.yaml, step 9.5) ---
# "model" starts the Ollama container on this machine's GPU. Leave empty when ITI_OLLAMA_URL points elsewhere
# (cloud set-up C2: Ollama on the laptop over a private link).
# "door" (the Caddy container) stays OFF by default: something else must face the network (the native Caddy on the
# laptop, or a cloud load balancer). Turn it on (COMPOSE_PROFILES=model,door) only where the users' PCs trust its
# root certificate, or on a server with a public DNS name (Caddy then gets a public certificate by itself).
# Ports the Caddy container publishes. Default 443 / 8443 on every address; for a test next to the native Caddy
# set them to 127.0.0.1:29443 / 127.0.0.1:29444 in the terminal (not here).
# ITI_CONSOLE_HTTPS_PORT=443
# ITI_API_HTTPS_PORT=8443
# The Caddy container's site names and certificate on THIS machine (left out = the laptop's names, Caddy's own CA).
# Addresses comma-separated; the API's end in :8443.
# ITI_CONSOLE_SITES=https://ai.example.local
# ITI_API_SITES=https://ai.example.local:8443
# internal = Caddy makes its own CA on first start (export its root.crt for IT, see the package README);
# /certs/site.pem /certs/site.key = company certificate files placed in deploy/certs; an email address = a public
# certificate (needs a public DNS name).
# ITI_TLS=internal
COMPOSE_PROFILES=model
# Where the API finds Ollama. Default http://ollama:11434 (the container above).
# ITI_OLLAMA_URL=http://ollama:11434
# Hosts ITI_OLLAMA_URL may name (a set value replaces the default). Add only a machine we run ourselves.
# ITI_OLLAMA_ALLOWED_HOSTS=127.0.0.1,localhost,::1,ollama
# Answers generated at once; also sets the Ollama container's OLLAMA_NUM_PARALLEL. The laptop load test chose 1.
ITI_LLM_PARALLEL=1
# The API's own settings (collections, HRDotNet / MCP secrets, CORS). The database, Ollama and upload settings
# above override the matching lines in it. Path relative to this deploy folder.
# ITI_API_ENV_FILE=../backend/.env
# Folder with the uploaded PDFs on this machine. Path relative to this deploy folder.
# ITI_UPLOADS_DIR=../data/uploads
# The session cookie is Secure (HTTPS only) by default (S1.2). false only if other PCs reach the Console over plain http.
# CONSOLE_COOKIE_SECURE=true
# Image tag to run; "dev" while building, a version for the package (9.5.7).
# ITI_IMAGE_TAG=dev