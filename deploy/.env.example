# deploy\.env.example: copy it to deploy\.env (never committed) and set a real, long, random password.
# docker compose reads it for POSTGRES_PASSWORD. ITI_DATABASE_URL in backend\.env must use the same password.
ITI_PG_PASSWORD=change-me-to-a-long-random-password

# SQL Server SA (admin) password for docker-compose.records.yml. Letters and digits only, 20+ characters,
# upper + lower case + digits (SQL Server's password rules). Used only to create the DB and run the scripts.
ITI_RECORDS_SA_PASSWORD=change-me-to-a-long-random-password
