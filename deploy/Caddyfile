# ITI AI Platform on the LAN (Phase 9, laptop pilot). Caddy is the ONLY thing reachable from the network:
# the console (2101) and the API (2102) themselves stay on 127.0.0.1. No secrets in this file (it is committed).
# Run:   C:\Tools\caddy\caddy.exe run --config deploy\Caddyfile        (from the repo root)
# Or as the caddy service of deploy/docker-compose.yaml (9.5.5): there ITI_CONSOLE_UPSTREAM / ITI_API_UPSTREAM point to
# game:4000 and api:8000; run natively they are unset and the defaults (127.0.0.1) apply.
# The console is game-ui (port 4000) since the G7 switch-over (D1, Vince 2026-10-28); admin-ui (3000) is retired.
# Check: C:\Tools\caddy\caddy.exe validate --config deploy\Caddyfile
# Names: the laptop's own DNS name works today; iti-ai / iti-ai-api work once the CNAMEs exist in ho.intellismartinc.com.
# Another machine sets its own names and certificate in deploy/.env (unset = this laptop's values below):
#   ITI_CONSOLE_SITES / ITI_API_SITES  the addresses, comma-separated, e.g. https://ai.example.local (API: ...:8443)
#   ITI_TLS  internal = Caddy's own CA (default) · /certs/site.pem /certs/site.key = company certificate files
#            (deploy/certs, mounted read-only) · an email address = a public certificate for a public DNS name
{
	auto_https disable_redirects # nothing on port 80
	skip_install_trust # never touch this machine's trust store; the users' PCs get root.crt from IT
}

# Console: the whole console for everyone on the LAN (Vince, 2026-10-28: the chat-only rule that sent every admin
# page to /chat is off). Each person sees only what their role allows: game-ui shows testers only Chat, FastAPI
# checks every permission, and risky actions still need the security password.
{$ITI_CONSOLE_SITES:https://ITI-Vinas.ho.intellismartinc.com:2101, https://iti-ai.ho.intellismartinc.com:2101} {
	tls {$ITI_TLS:internal}

	request_body {
		max_size 60MB # the API's upload limit is 50 MB
	}

	header -Server # S1.1: don't advertise the software; the console's own security headers come from game-ui/next.config.ts

	reverse_proxy {$ITI_CONSOLE_UPSTREAM:127.0.0.1:4000} {
		# The person's computer for the login throttle (S2.1). Caddy sets it itself and replaces any value a browser
		# sends; the console passes it on to POST /v1/console/login. No header = the laptop itself (127.0.0.1:4000).
		header_up ITI-Client-IP {remote_host}
		transport http {
			read_timeout 180s # answers can queue for 120 s
		}
	}
}

# API, for the C# apps (firewall: only their machines reach 8443). Swagger and the admin / console routes are
# hidden: the C# apps need only the v1 contract (integration-kit/openapi-v1.json).
{$ITI_API_SITES:https://ITI-Vinas.ho.intellismartinc.com:2102, https://iti-ai-api.ho.intellismartinc.com:2102} {
	tls {$ITI_TLS:internal}

	request_body {
		max_size 60MB
	}

	# S1.1: the API returns only data (JSON), so nothing may run, load or frame from it. HSTS waits for the office PCs
	# to trust the Caddy root (with HSTS a certificate warning can no longer be clicked past).
	@docs path /v1/docs
	@not_docs not path /v1/docs

	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	header @not_docs Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
	# Swagger UI (the C# teams' docs): its script and styles come from jsdelivr, plus one inline start-up script
	header @docs Content-Security-Policy "default-src 'none'; script-src https://cdn.jsdelivr.net 'unsafe-inline'; style-src https://cdn.jsdelivr.net 'unsafe-inline'; img-src https://fastapi.tiangolo.com https://cdn.jsdelivr.net data:; connect-src 'self'; frame-ancestors 'none'"

	@not_for_apps path /docs /docs/* /redoc /openapi.json /v1/admin/* /v1/console/*
	respond @not_for_apps 404

	reverse_proxy {$ITI_API_UPSTREAM:127.0.0.1:8000} {
		transport http {
			read_timeout 180s
		}
	}
}
