"""TEMPLATE for a new tool (like .env.example). To add a tool:
1. Copy this file to app/tools/catalog/<file_name>.py (e.g. overtime.py) and replace every CAPITAL placeholder.
2. Add it to TOOLS in app/tools/catalog/registry.py:  from app.tools.catalog import <file_name>  ...  <file_name>.TOOL
3. If its view is new: add it to deploy/records-db/02_ai_access.sql (schema "ai", only the columns it needs).
4. Run the checks (ruff, pytest) and the live check. The records MCP server offers the new tool automatically.

Rules (the safety of every tool depends on them):
- NEVER put employee_id in the arguments or the schema: run(conn, employee_id, args) gets it from ITI-User-Id.
- A fixed SQL query with bound parameters (:name), always WHERE employee_id = :employee_id; never build SQL text.
- Read only from views in schema "ai". Numbers and dates as text (CONVERT), so the model quotes them exactly.
- The description says "the CURRENT USER's own ..." and what the tool is NOT for (the model picks by it).
- describe() returns a title naming WHAT was read, never values."""

from pydantic import BaseModel, ConfigDict, Field
from sqlalchemy import Connection, text

from app.tools.shared.tool import Tool
from app.tools.shared.tool_spec import ToolSpec


class NewToolArgs(BaseModel):
    """What the model may fill in. extra="forbid": an unknown field (e.g. employee_id) is refused."""

    model_config = ConfigDict(extra="forbid")

    NEW_ARGUMENT: int | None = Field(default=None, ge=0)  # replace: name, type, limits; None = a sensible default


SQL = text("""
    SELECT NEW_COLUMNS
    FROM ai.NEW_VIEW
    WHERE employee_id = :employee_id
""")


def new_tool(conn: Connection, employee_id: str, args: NewToolArgs) -> dict:
    rows = conn.execute(SQL, {"employee_id": employee_id})
    return {"rows": [dict(row._mapping) for row in rows]}  # replace: the shape the model reads


def describe(result: dict) -> tuple[str, bool]:
    return "Records: NEW_WHAT_WAS_READ", bool(result["rows"])  # (source title, holds data)


TOOL = Tool(
    spec=ToolSpec(
        name="NEW_TOOL_NAME",  # e.g. get_my_overtime; lowercase with "_"
        description="Get the CURRENT USER's own NEW_WHAT. Not for NEW_WHAT_NOT.",
        parameters={
            "type": "object",
            "properties": {"NEW_ARGUMENT": {"type": "integer", "description": "NEW_ARGUMENT_HELP. Leave out for NEW_DEFAULT"}},
        },
        scope="records:read",  # or a new scope: then also add it to Scope in app/admin/a_schemas/key_create.py
    ),
    args=NewToolArgs,
    run=new_tool,
    describe=describe,
    topic="NEW_TOPIC",  # a few words for the system prompt, e.g. "overtime"
)
