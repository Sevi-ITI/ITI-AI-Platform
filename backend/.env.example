# backend\.env.example: every setting the service reads, with its default value.
# Copy it to backend\.env and change only what differs on this computer. backend\.env is never committed.
# All names start with ITI_. A line starting with # is ignored, so the defaults below are only for reference.
# Lists are JSON, e.g. ["iti-docs","finance-docs"]. Restart the server after any change.

# --- Database: Postgres + pgvector (deploy\docker-compose.dev.yaml on the laptop) ---
# The password must match ITI_PG_PASSWORD in deploy\.env.
ITI_DATABASE_URL=postgresql+psycopg://iti:change-me-to-a-long-random-password@127.0.0.1:5432/iti_ai
# ITI_DB_POOL_SIZE=10
# ITI_DB_MAX_OVERFLOW=10

# --- Records DB (Phase 8): SQL Server, read-only login iti_ai_reader (deploy\records-db\README.md) ---
# Empty or missing = records tools off. The password is the one typed for iti_ai_reader in README step 3:
# letters and digits only, so it needs no escaping in this URL. TrustServerCertificate=yes only on 127.0.0.1.
# ITI_RECORDS_DB_URL=mssql+mssqlpython://iti_ai_reader:change-me-to-a-long-random-password@127.0.0.1:1433/iti_records?Encrypt=yes&TrustServerCertificate=yes

# --- MCP servers: the list is app	ools\client\servers.py; only each server's SECRET lives here ---
# One line per server, named as its "token_env" in servers.py. The AI host sends it, the server checks it.
# Letters and digits, 20+ characters. A server is used only when it is enabled in servers.py AND its secret is set.
# ITI_MCP_RECORDS_TOKEN=change-me-to-a-long-random-secret

# --- Collections: the document sets keys can be given ---
# ITI_COLLECTIONS=["iti-docs"]

# --- Ollama: must run on this computer (rag/config.py refuses any other host) ---
# ITI_OLLAMA_URL=http://127.0.0.1:11434
# ITI_CHAT_MODEL=qwen3.5:4b
# Changing the embedding model means indexing every document again.
# ITI_EMBED_MODEL=bge-m3
# How many answers are generated at once. MUST equal Ollama's own OLLAMA_NUM_PARALLEL.
# ITI_LLM_PARALLEL=2
# Seconds a question may wait for a free slot before 503 llm_busy.
# ITI_LLM_QUEUE_TIMEOUT_S=120

# --- Uploads ---
# Relative to the folder uvicorn is started from (backend\).
# ITI_UPLOAD_DIR=../data/uploads
# ITI_MAX_UPLOAD_MB=50

# --- Logs ---
# ITI_LOG_LEVEL=INFO
# Request logs older than this are deleted at startup (RA 10173: keep personal data no longer than needed).
# ITI_LOG_RETENTION_DAYS=90
