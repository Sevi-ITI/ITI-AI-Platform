# Copy to .env.local (git-ignored). No secrets belong in this file.
# Server-only: the browser never talks to FastAPI, so never prefix these with NEXT_PUBLIC_.
ITI_API_URL=http://127.0.0.1:8000
# true once the console is served over HTTPS (deployment)
CONSOLE_COOKIE_SECURE=false
NEXT_TELEMETRY_DISABLED=1
