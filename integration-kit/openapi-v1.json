{
  "openapi": "3.1.0",
  "info": {
    "title": "ITI AI API",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Get Health",
        "description": "Is the service up? Replies {\"status\": \"ok\"}. No key needed; checks neither the database nor the model.",
        "operationId": "get_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Get Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Ask a question",
        "description": "The answer comes only from the collection's documents, with file and page citations. found = false is the\n\"I don't know\" reply (a normal 200: show it like any answer). Leave conversation_id out, null or empty to start a\nnew conversation; send the previous reply's conversation_id for a follow-up.\nAnswers can queue: use a timeout of at least 150 s.",
        "operationId": "post_chat_v1_chat_post",
        "security": [
          {
            "APIKeyHeader": []
          },
          {
            "ConsoleSession": []
          }
        ],
        "parameters": [
          {
            "name": "ITI-User-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "title": "Iti-User-Id"
            },
            "description": "Required: the signed-in person's permanent id from your server's session."
          },
          {
            "name": "ITI-User-Role",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 50
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional label (e.g. 'hr staff') shown in the console; doesn't change access.",
              "title": "Iti-User-Role"
            },
            "description": "Optional label (e.g. 'hr staff') shown in the console; doesn't change access."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "401": {
            "description": "**invalid_api_key**: key missing, wrong, revoked or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "**scope_forbidden**: this key may not use this route\n\n**collection_forbidden**: this key may not read that collection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "**collection_not_found**: no collection with that name\n\n**conversation_not_found**: no such conversation for this user (or it is someone else's)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "**invalid_request**: a field or header is missing or invalid (e.g. no ITI-User-Id, question over 4,000)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "**internal_error**: a bug on the AI side: quote the request_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "**llm_busy**: queue full: retry once after a pause\n\n**llm_unavailable**: the model is down: no retry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat/stream": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Ask a question, answer streamed",
        "description": "Same body and rules as POST /v1/chat, but the answer arrives word by word. A refused call (bad key, unknown\ncollection or conversation, missing ITI-User-Id) gets a normal JSON error before any event is sent.",
        "operationId": "post_chat_stream_v1_chat_stream_post",
        "security": [
          {
            "APIKeyHeader": []
          },
          {
            "ConsoleSession": []
          }
        ],
        "parameters": [
          {
            "name": "ITI-User-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "title": "Iti-User-Id"
            },
            "description": "Required: the signed-in person's permanent id from your server's session."
          },
          {
            "name": "ITI-User-Role",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 50
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional label (e.g. 'hr staff') shown in the console; doesn't change access.",
              "title": "Iti-User-Role"
            },
            "description": "Optional label (e.g. 'hr staff') shown in the console; doesn't change access."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A stream of Server-Sent Events, in this order:\n\n1. **meta** {conversation_id, request_id}\n2. **token** {text}, many: append each to the screen\n3. **done** {answer, found, citations}: replace the shown text with answer (it can differ from the tokens)\n\nor, if it fails after it started, **error** {code, message}: llm_busy, llm_unavailable or internal_error.",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string"
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "**invalid_api_key**: key missing, wrong, revoked or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "**scope_forbidden**: this key may not use this route\n\n**collection_forbidden**: this key may not read that collection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "**collection_not_found**: no collection with that name\n\n**conversation_not_found**: no such conversation for this user (or it is someone else's)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "**invalid_request**: a field or header is missing or invalid (e.g. no ITI-User-Id, question over 4,000)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "**internal_error**: a bug on the AI side: quote the request_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
