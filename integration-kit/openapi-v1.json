  "components": {
    "schemas": {
      "Body_post_document_v1_documents_post": {
        "properties": {
          "collection": {
            "type": "string",
            "title": "Collection"
          },
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "replace": {
            "type": "boolean",
            "title": "Replace",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "collection",
          "file"
        ],
        "title": "Body_post_document_v1_documents_post"
      },
      "ChatRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question",
            "description": "The user's question, as typed."
          },
          "collection": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Collection",
            "description": "Which document set to answer from (given with your key, e.g. iti-docs)."
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id",
            "description": "Leave it out, null or empty for a new conversation; the previous reply's id for a follow-up."
          }
        },
        "type": "object",
        "required": [
          "question",
          "collection"
        ],
        "title": "ChatRequest",
        "examples": [
          {
            "collection": "iti-docs",
            "question": "How many leave days do new employees get?"
          }
        ]
      },
      "ChatResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer",
            "description": "Markdown (lists, bold, tables): render it as Markdown."
          },
          "found": {
            "type": "boolean",
            "title": "Found",
            "description": "False = the documents don't contain the answer (the \"I don't know\" reply)."
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations",
            "description": "The sources behind the answer; empty when found is false."
          },
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id",
            "description": "Send it back in the next question to continue this conversation."
          },
          "request_id": {
            "type": "string",
            "title": "Request Id",
            "description": "Quote it to the ITI AI admin when reporting a problem."
          }
        },
        "type": "object",
        "required": [
          "answer",
          "found",
          "citations",
          "conversation_id",
          "request_id"
        ],
        "title": "ChatResponse"
      },
      "Citation": {
        "properties": {
          "doc_id": {
            "type": "string",
            "title": "Doc Id",
            "description": "The document's id (today its file name)."
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "The file name to show the user."
          },
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page",
            "description": "The PDF page (1 = first); null when unknown."
          },
          "snippet": {
            "type": "string",
            "title": "Snippet",
            "description": "The start of the cited passage, not an exact quote."
          }
        },
        "type": "object",
        "required": [
          "doc_id",
          "title",
          "snippet"
        ],
        "title": "Citation"
      },
      "ConversationSummary": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id",
            "description": "Use it to read the messages or to continue the conversation."
          },
          "collection": {
            "type": "string",
            "title": "Collection",
            "description": "The document set this conversation asks."
          },
          "first_question": {
            "type": "string",
            "title": "First Question",
            "description": "The conversation's first question: a title for the list."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "When it started, UTC."
          }
        },
        "type": "object",
        "required": [
          "conversation_id",
          "collection",
          "first_question",
          "created_at"
        ],
        "title": "ConversationSummary"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "error",
          "request_id"
        ],
        "title": "ErrorResponse"
      },
      "JobStatus": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "done",
              "failed"
            ],
            "title": "Status"
          },
          "chunks": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chunks"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "document_id",
          "filename",
          "status",
          "created_at"
        ],
        "title": "JobStatus"
      },
      "MessageOut": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "description": "user = a question, assistant = an answer."
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "The question, or the answer in Markdown."
          },
          "request_id": {
            "type": "string",
            "title": "Request Id",
            "description": "The call that wrote this message."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "When it was written, UTC."
          },
          "citations": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Citation"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Citations",
            "description": "An answer's sources; null for questions."
          }
        },
        "type": "object",
        "required": [
          "role",
          "content",
          "request_id",
          "created_at"
        ],
        "title": "MessageOut"
      },
      "UploadAccepted": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "done",
              "failed"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "document_id",
          "status"
        ],
        "title": "UploadAccepted"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "ITI-Api-Key"
      },
      "ConsoleSession": {
        "type": "apiKey",
        "in": "header",
        "name": "ITI-Console-Session"
      }
    }
  }
}
